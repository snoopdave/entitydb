{
  "name": "@entity-db/mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for EntityDB",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "tsc; node --loader ts-node/esm src/integration.tests.ts",
    "count": "tsc; node --loader ts-node/esm src/countposts.ts"
  },
  "keywords": [
    "mcp",
    "entity-db",
    "llm",
    "openctx"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
